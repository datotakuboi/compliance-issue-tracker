generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  VIEWER
  ANALYST
  APPROVER
  SERVICE
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Status {
  OPEN
  IN_PROGRESS
  PENDING_REVIEW
  COMPLETED
}

enum RunState {
  BLOCKED
  PROPOSED
  APPROVED
  REJECTED
  EXECUTED
}

model User {
  id           String         @id @default(cuid())
  name         String
  role         Role
  sessions     Session[]
  ownedIssues  Issue[]
  evidence     Evidence[]
  runs         PlaybookRun[]
  approvals    Approval[]
  audit        AuditEvent[]
  tokens       ServiceToken[]
}

model Session {
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
}

model ServiceToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  scopes    String[]
  expiresAt DateTime
  revokedAt DateTime?
}

model Issue {
  id          String        @id @default(cuid())
  title       String
  description String
  severity    Severity
  status      Status        @default(OPEN)
  ownerId     String?
  owner       User?         @relation(fields: [ownerId], references: [id])
  dueDate     DateTime       @db.Date
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  evidence    Evidence[]
  runs        PlaybookRun[]
  audit       AuditEvent[]

  @@index([status, dueDate])
  @@index([ownerId])
}

model Evidence {
  id          String   @id @default(cuid())
  issueId     String
  issue       Issue    @relation(fields: [issueId], references: [id])
  url         String
  description String
  submitterId String
  submitter   User     @relation(fields: [submitterId], references: [id])
  createdAt   DateTime @default(now())

  @@index([issueId])
}

model PlaybookRun {
  id              String    @id @default(cuid())
  issueId         String
  issue           Issue     @relation(fields: [issueId], references: [id])
  requesterId     String
  requester       User      @relation(fields: [requesterId], references: [id])
  analyzedVersion Int
  findings        Json
  actions         Json
  state           RunState
  createdAt       DateTime  @default(now())
  executedAt      DateTime?
  approval        Approval?

  @@index([issueId, createdAt])
}

model Approval {
  id         String      @id @default(cuid())
  runId      String      @unique
  run        PlaybookRun @relation(fields: [runId], references: [id])
  reviewerId String
  reviewer   User        @relation(fields: [reviewerId], references: [id])
  approved   Boolean
  note       String
  createdAt  DateTime    @default(now())
}

model AuditEvent {
  id            String   @id @default(cuid())
  issueId       String
  issue         Issue    @relation(fields: [issueId], references: [id])
  actorId       String
  actor         User     @relation(fields: [actorId], references: [id])
  action        String
  details       Json
  correlationId String
  createdAt     DateTime @default(now())

  @@index([issueId, createdAt])
}