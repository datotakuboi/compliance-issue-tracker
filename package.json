{
  "name": "compliwise-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts tests prisma/seed.ts *.ts *.json *.md *.yaml .github/workflows/*.yml",
    "format:check": "prettier --check src scripts tests prisma/seed.ts *.ts *.json *.md *.yaml .github/workflows/*.yml",
    "db:local": "node --env-file=.env scripts/local-db.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file=.env prisma/seed.ts",
    "mcp": "node --env-file=.env src/mcp/index.ts",
    "test": "vitest run",
    "test:integration": "node --env-file=.env scripts/test-integration.ts",
    "test:e2e": "node --env-file=.env scripts/test-e2e.ts",
    "test:mcp": "node --env-file=.env scripts/mcp-demo.ts",
    "token:create": "node --env-file=.env scripts/create-token.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/manrope": "^5.2.0",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@prisma/client": "6.19.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "18.6.0-beta.19",
    "prisma": "6.19.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "effect": "^3.20.0"
  }
}
